    <PackageReference Include="Umbraco.Commerce" Version="17.1.3" />
    <PackageReference Include="Umbraco.Commerce.Cms.Startup" Version="17.1.3" />
    <PackageReference Include="Umbraco.Commerce.Cms.Web.Api.Storefront" Version="17.1.3" />
    <PackageReference Include="Umbraco.Commerce.Persistence.Sqlite" Version="17.1.3" />
    <PackageReference Include="Umbraco.Licenses" Version="17.0.2" />
  </ItemGroup>

</Project>
